# ── Stage 1: Build Go Observability Microservice ──
FROM golang:1.26-alpine AS builder

WORKDIR /app
COPY observability-service/go.mod observability-service/go.sum ./
RUN go mod download

COPY observability-service/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o observability-bin .

# ── Stage 2: Minimal Runtime ──
FROM alpine:3.22

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app
COPY --from=builder /app/observability-bin .

ENV PORT=8082
EXPOSE 8082
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- "http://127.0.0.1:${PORT}/health" >/dev/null || exit 1

CMD ["./observability-bin"]
