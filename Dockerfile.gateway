# ── Stage 1: Build Go Gateway ──
FROM golang:1.24-alpine AS builder

WORKDIR /app
COPY gateway/go.mod gateway/go.sum ./
RUN go mod download

COPY gateway/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o gateway-bin .

# ── Stage 2: Minimal Runtime ──
FROM alpine:3.20

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app
COPY --from=builder /app/gateway-bin .

ENV PORT=8080
EXPOSE 8080

CMD ["./gateway-bin"]
