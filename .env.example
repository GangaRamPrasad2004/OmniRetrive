# Local Docker Compose settings. Replace placeholders before use.
# Generate POSTGRES_PASSWORD and JWT_SECRET locally; never reuse these examples.
POSTGRES_USER=omniretrive
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=omniretrive
JWT_SECRET=replace-with-at-least-32-random-bytes

# Optional direct PostgreSQL URL for local Tern commands. When set, it overrides
# PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE for the gateway and migration helper.
DATABASE_URL=

# Hugging Face Inference API token for embeddings and answer generation.
HF_TOKEN=

# Optional Qdrant API key; leave empty for the local Compose Qdrant service.
QDRANT_API_KEY=

# Optional upload limit (MiB).
MAX_UPLOAD_SIZE_MB=50

# Original PDF storage: local is suitable for development; s3 works with AWS S3,
# Cloudflare R2, or a compatible private endpoint.
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Comma-separated browser origins permitted by the Go gateway.
FRONTEND_ORIGINS=http://localhost:3000

# Keep false for local development. Configure TLS/origins separately in production.
IS_PRODUCTION=false
